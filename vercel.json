{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" },
    {
      "source": "/login",
      "destination": "https://one-winq-pi.vercel.app/"
    },
    {
      "source": "/:path*",
      "destination": "https://one-winq-pi.vercel.app/:path*"
    }
  ]
}
